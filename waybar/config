{
    "layer": "top",
    "position": "top",
    "height": 32,
    
    "spacing": 0,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "mpris",
        "cava",
        "custom/weather",
        "cpu",
        "memory",
        "custom/wallpaper",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "trip_origin",
            "default": "square",
            "urgent": ""
        },
        "persistent-workspaces": {
            "*": 5
        },
        "all-outputs": false,
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "disable-scroll-wraparound": true
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 46,
        "separate-outputs": true,
        "rewrite": {
            "(.*)": "$1"
        }
    },

    "clock": {
        "format": "{:%I:%M:%S}",
        "format-alt": "{:%I:%M:%S}",
        "interval": 1,
        "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt>{calendar}</tt>"
    },

    "mpris": {
        "format": "{player_icon} {title}",
        "format-paused": "{status_icon} {title}",
        "format-stopped": "",
        "player-icons": {
            "default": "󰎆",
            "brave": "󰖟",
            "firefox": "󰈹",
            "spotify": "󰓇"
        },
        "status-icons": {
            "playing": "󰐊",
            "paused": "󰏤",
            "stopped": "󰓛"
        },
        "max-length": 30,
        "max-field-size": {
            "title": 30,
            "artist": 20
        },
        "tooltip-format": "{player}: {artist} - {title}",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "cava": {
        "framerate": 30,
        "autosens": 1,
        "bars": 8,
        "lower_cutoff_freq": 50,
        "higher_cutoff_freq": 10000,
        "method": "pulse",
        "source": "auto",
        "bar_delimiter": 0,
        "format-icons": [
            "▁",
            "▂",
            "▃",
            "▄",
            "▅",
            "▆",
            "▇",
            "█"
        ],
        "actions": {
            "on-click-right": "mode"
        }
    },

    "cpu": {
        "interval": 2,
        "format": " {usage}%",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },

    "memory": {
        "interval": 5,
        "format": "󰍛 {percentage}%",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },

    "custom/weather": {
        "format": "{}",
        "interval": 600,
        "exec": "~/.config/waybar/scripts/weather.sh",
        "return-type": "json",
        "on-click": "xdg-open 'https://www.weather.com/'",
        "tooltip": true
    },

    "custom/wallpaper": {
        "format": "󰸉",
        "tooltip": "Wallpaper",
        "on-click": "~/.config/waybar/scripts/wallpaper.sh"
    },

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "wlogout"
    }
}